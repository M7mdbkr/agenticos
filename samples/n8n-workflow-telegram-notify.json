{
  "name": "Notify on Approved Action",
  "nodes": [
    {
      "parameters": {
        "path": "personal-os/action-approved",
        "responseMode": "onReceived",
        "responseData": {
          "responseCode": 200,
          "responseBody": {
            "status": "ok",
            "message": "Action approved notification received"
          }
        },
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "-1001234567890",
